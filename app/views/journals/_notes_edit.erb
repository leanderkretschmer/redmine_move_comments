<div style="margin-top: 15px; padding: 10px; border-top: 1px solid #e0e0e0; background: #fafafa;">
  <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
    <strong><%=h t('label_move_to_issue') %></strong>
    <%= text_field_tag :new_issue_id, '', :placeholder => 'ID...', :style => 'width: 80px; padding: 3px;' %>
    <% if defined?(enable_ticket_search) && enable_ticket_search %>
      <%= text_field_tag :ticket_search, '', :placeholder => t('placeholder_search_tickets'),
                         :style => 'width: 260px; padding: 3px; font-size: 12px;',
                         :autocomplete => 'off',
                         :oninput => 'autocompleteTickets(this.value)' %>
      <div id="ticket-autocomplete" style="position: relative;">
        <div id="ticket-autocomplete-list" style="position: absolute; background: white; border: 1px solid #ddd; width: 260px; max-height: 180px; overflow-y: auto; z-index: 9999; display: none; pointer-events: none;"></div>
      </div>
    <% end %>
  </div>

  <% if defined?(show_user_tickets) && show_user_tickets && defined?(user_tickets) && user_tickets.any? %>
    <div style="margin-top: 8px;">
      <div id="ticket-list" style="max-height: 120px; overflow-y: auto; border: 1px solid #ddd; background: white;">
        <% user_tickets.each do |ticket| %>
          <div class="ticket-item" style="padding: 4px 8px; cursor: pointer; border-bottom: 1px solid #f0f0f0; font-size: 12px;"
               onclick="document.getElementById('new_issue_id').value='<%= ticket[:id] %>';"
               onmouseover="this.style.backgroundColor='#e6f3ff';"
               onmouseout="this.style.backgroundColor='';">
            <div style="font-weight: bold; color: #169;">#<%= ticket[:id] %></div>
            <div style="color: #333; margin-top: 2px;"><%= truncate(ticket[:subject], :length => 45) %></div>
            <% if defined?(show_project_info) && show_project_info && ticket[:project] %>
              <div style="color: #666; font-size: 10px; margin-top: 2px;"><%= ticket[:project] %></div>
            <% end %>
          </div>
        <% end %>
      </div>
      <div style="font-size: 10px; color: #666; margin-top: 4px; text-align: center;">
        <%=h t('text_click_to_select_ticket') %>
      </div>
    </div>
  <% end %>
</div>

<script>
(function() {
  var MC_ORIGIN_PROJECT_ID = <%= origin_project_id.to_i %>;
  var MC_ORIGIN_PROJECT_NAME = <%= origin_project_name.to_s.to_json.html_safe %>;
  var MC_LABELS = {
    warningTitle:  <%= t('label_cross_project_warning').to_json.html_safe %>,
    warningText:   <%= t('text_cross_project_warning').to_json.html_safe %>,
    cancelBtn:     <%= t('button_cancel_move').to_json.html_safe %>,
    okBtn:         <%= t('button_confirm_move').to_json.html_safe %>
  };

  // ── Modal ────────────────────────────────────────────────────────────────
  function ensureModal() {
    var overlay = document.getElementById('mc-warn-overlay');
    if (overlay) return overlay;

    overlay = document.createElement('div');
    overlay.id = 'mc-warn-overlay';
    overlay.style.cssText = 'display:none;position:fixed;top:0;left:0;width:100%;height:100%;' +
      'background:rgba(0,0,0,0.45);z-index:99998;align-items:center;justify-content:center;';

    var box = document.createElement('div');
    box.style.cssText = 'background:#fff;border:1px solid #bbb;border-radius:3px;padding:24px 28px 20px;' +
      'max-width:440px;width:90%;box-shadow:0 4px 16px rgba(0,0,0,0.18);font-size:13px;font-family:inherit;';

    var title = document.createElement('p');
    title.id = 'mc-warn-title';
    title.style.cssText = 'margin:0 0 10px 0;font-weight:bold;font-size:14px;color:#c00;';

    var text = document.createElement('p');
    text.id = 'mc-warn-text';
    text.style.cssText = 'margin:0 0 18px 0;line-height:1.5;color:#333;';

    var btnRow = document.createElement('div');
    btnRow.style.cssText = 'text-align:right;';

    var cancelBtn = document.createElement('button');
    cancelBtn.id = 'mc-warn-cancel';
    cancelBtn.type = 'button';
    cancelBtn.style.cssText = 'margin-right:10px;padding:5px 16px;cursor:pointer;';

    var okBtn = document.createElement('button');
    okBtn.id = 'mc-warn-ok';
    okBtn.type = 'button';
    okBtn.style.cssText = 'padding:5px 16px;background:#c00;color:#fff;border:1px solid #a00;border-radius:2px;cursor:pointer;';

    btnRow.appendChild(cancelBtn);
    btnRow.appendChild(okBtn);
    box.appendChild(title);
    box.appendChild(text);
    box.appendChild(btnRow);
    overlay.appendChild(box);
    document.body.appendChild(overlay);
    return overlay;
  }

  function showWarningModal(targetProjectName, targetIssueId, onConfirm, onCancel) {
    var overlay = ensureModal();
    var warningText = MC_LABELS.warningText
      .replace('%{issue_id}', targetIssueId)
      .replace('%{target_project}', targetProjectName)
      .replace('%{source_project}', MC_ORIGIN_PROJECT_NAME);

    document.getElementById('mc-warn-title').textContent = MC_LABELS.warningTitle;
    document.getElementById('mc-warn-text').textContent = warningText;
    document.getElementById('mc-warn-cancel').textContent = MC_LABELS.cancelBtn;
    document.getElementById('mc-warn-ok').textContent = MC_LABELS.okBtn;

    document.getElementById('mc-warn-cancel').onclick = function() {
      overlay.style.display = 'none';
      onCancel();
    };
    document.getElementById('mc-warn-ok').onclick = function() {
      overlay.style.display = 'none';
      onConfirm();
    };

    overlay.style.display = 'flex';
  }

  // ── Form-Submit-Interceptor ───────────────────────────────────────────────
  var submittingAfterConfirmation = false;

  function getIssueIdField() { return document.getElementById('new_issue_id'); }
  function getParentForm() {
    var f = getIssueIdField();
    return f ? f.closest('form') : null;
  }

  function proceedWithSubmit(form) {
    submittingAfterConfirmation = true;
    if (typeof form.requestSubmit === 'function') {
      form.requestSubmit();
    } else {
      form.submit();
    }
  }

  function checkProjectAndProceed(form) {
    var field = getIssueIdField();
    if (!field || !field.value.trim()) {
      proceedWithSubmit(form);
      return;
    }
    var issueId = field.value.trim();

    fetch('/move_comments_search/check_issue_project?issue_id=' + encodeURIComponent(issueId), {
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.project_id && MC_ORIGIN_PROJECT_ID && String(data.project_id) !== String(MC_ORIGIN_PROJECT_ID)) {
        showWarningModal(
          data.project_name,
          data.issue_id,
          function() { proceedWithSubmit(form); },
          function() { /* cancel – nothing to do */ }
        );
      } else {
        proceedWithSubmit(form);
      }
    })
    .catch(function() {
      proceedWithSubmit(form);
    });
  }

  function handleFormSubmit(e) {
    var field = getIssueIdField();
    if (!field || !field.value.trim()) return;

    if (submittingAfterConfirmation) {
      submittingAfterConfirmation = false;
      return;
    }

    e.preventDefault();
    if (e.stopPropagation) e.stopPropagation();
    checkProjectAndProceed(e.currentTarget);
  }

  function initListeners() {
    var form = getParentForm();
    if (form && !form._mcSubmitListenerAdded) {
      form.addEventListener('submit', handleFormSubmit);
      form._mcSubmitListenerAdded = true;
    }

    var field = getIssueIdField();
    if (field && !field._mcKeyListenerAdded) {
      field.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          var f = getParentForm();
          if (f) checkProjectAndProceed(f);
        }
      });
      field._mcKeyListenerAdded = true;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initListeners);
  } else {
    initListeners();
  }

  // ── Autocomplete ─────────────────────────────────────────────────────────
  <% if defined?(enable_ticket_search) && enable_ticket_search %>
  window.autocompleteTickets = function(term) {
    var list = document.getElementById('ticket-autocomplete-list');
    if (!list) return;
    var trimmed = (term || '').trim();
    if (trimmed.length < 1) {
      list.style.display = 'none';
      list.style.pointerEvents = 'none';
      list.innerHTML = '';
      return;
    }
    var projectParam = MC_ORIGIN_PROJECT_ID ? ('&project_id=' + MC_ORIGIN_PROJECT_ID) : '';
    fetch('/move_comments_search/issues?term=' + encodeURIComponent(trimmed) + projectParam, {
      headers: { 'Accept': 'application/json' }
    })
    .then(function(res) { if (!res.ok) throw new Error(); return res.json(); })
    .then(function(data) {
      list.innerHTML = '';
      data.forEach(function(item) {
        var row = document.createElement('div');
        row.style.cssText = 'padding:4px 8px;cursor:pointer;border-bottom:1px solid #f0f0f0;';
        var project = item.project ? (' — ' + item.project) : '';
        row.textContent = '#' + item.id + ' ' + (item.subject || '') + project;
        row.onclick = function() {
          document.getElementById('new_issue_id').value = item.id;
          list.style.display = 'none';
          list.innerHTML = '';
        };
        row.onmouseover = function() { row.style.backgroundColor = '#e6f3ff'; };
        row.onmouseout  = function() { row.style.backgroundColor = ''; };
        list.appendChild(row);
      });
      list.style.display = data.length ? 'block' : 'none';
      list.style.pointerEvents = data.length ? 'auto' : 'none';
    })
    .catch(function() {
      list.style.display = 'none';
      list.style.pointerEvents = 'none';
      list.innerHTML = '';
    });
  };

  document.addEventListener('click', function(e) {
    var list = document.getElementById('ticket-autocomplete-list');
    var input = document.getElementById('ticket_search');
    if (!list) return;
    if (!list.contains(e.target) && !(input && input.contains(e.target))) {
      list.style.display = 'none';
      list.style.pointerEvents = 'none';
      list.innerHTML = '';
    }
  });
  <% end %>
})();
</script>
